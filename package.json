{
  "name": "dsh-mv-hub",
  "version": "1.2.1",
  "private": true,
  "description": "MV 合集：内置默认 MV、合集包按需下载，支持导入自己的 MV、新建合集，并给 DSH / 外部 agent 预留发布接口",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": { "node": ">=18" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "icon": "./icon.png",
  "meta": {
    "title": "MV 合集",
    "description": "内置默认 P(doom)，其他合集按需下载；导入自己的 MV、新建合集，DSH 可以直接把做好的 MV 发布进来。附源码、画面帧与发布接口。"
  },
  "files": [
    "index.js",
    "client.js",
    "catalog.json",
    "cordis.patch.yml",
    "icon.png",
    "lib/",
    "ref/",
    "web/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
